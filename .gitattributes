# ============================================
# 1. 行尾符规范 (换行符统一)
# ============================================
# 自动推断文本文件并统一为 LF
* text=auto eol=lf

# C# 代码规范对照
*.cs text diff=csharp
*.cginc text
*.shader text
*.json text
*.xml text
*.txt text

